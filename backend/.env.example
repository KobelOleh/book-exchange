PORT=4000
DATABASE_URL="postgresql://app:app@localhost:5432/app"

# Auth
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_EXPIRES_IN=7d
# Login attempts per account (and registrations per client) allowed per minute
AUTH_RATE_LIMIT=10

# Seed (npx prisma db seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
DEMO_USER_PASSWORD=change-me-demo-password
